{
  "name": "CyberCheckmate",
  "short_name": "CheckMate",
  "description": "Check any suspicious message, link or screenshot for scams.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#051F20",
  "theme_color": "#051F20",
  "lang": "en",
  "dir": "ltr",
  "orientation": "portrait-primary",
  "categories": ["utilities", "security"],
  "icons": [
    {
      "src": "/assets/brand/logo-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/logo-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/logo-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    }
  ],
  "screenshots": [],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "image", "accept": ["image/*"] }
      ]
    }
  }
}
