# Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=

# Groq API key (from Groq Console, free tier)
GROQ_API_KEY=

# Gemini model identifier (e.g., gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Groq model identifier (e.g., llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Shared secret token for protecting /admin/* management endpoints
ADMIN_TOKEN=
